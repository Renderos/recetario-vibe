# ─────────────────────────────────────────────────────────────
# Sazón · Recetario — variables de entorno
# Copia este archivo como .env.local y ajusta los valores.
# ─────────────────────────────────────────────────────────────

# URL base de la API de TheMealDB (sin barra final).
MEALDB_API_URL=https://www.themealdb.com/api/json/v1

# API key de TheMealDB. "1" es la key pública de desarrollo;
# si tienes una key Premium (Patreon), colócala aquí.
# Solo se usa en el servidor (Route Handlers / Server Components),
# nunca se expone al navegador.
MEALDB_API_KEY=1

# Nombre público de la app (visible en el navegador, por eso lleva NEXT_PUBLIC_).
NEXT_PUBLIC_APP_NAME=Sazón
